#!/usr/bin/env sh
set -e

staged=$(mktemp)
trap 'rm -f "$staged"' EXIT

# --- Image compression -------------------------------------------------------
git diff --cached --name-only -z --diff-filter=ACM -- \
  '*.png' '*.jpg' '*.jpeg' '*.PNG' '*.JPG' '*.JPEG' > "$staged"

if [ -s "$staged" ]; then
  xargs -0 pnpm images:compress < "$staged"
  xargs -0 git add -- < "$staged"
fi

# --- Glossary validation -----------------------------------------------------
# Only when a glossary source is staged: the validator parses every locale
# file, so it does not need the staged paths themselves — just the signal that
# the glossary changed. Errors block the commit; translation-gap warnings do
# not (see scripts/glossary-validate.ts for the exit-code policy).
if ! git diff --cached --quiet --diff-filter=ACM -- 'config/glossary/*.yaml'; then
  pnpm glossary:validate
fi
