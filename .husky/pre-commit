#!/usr/bin/env sh
set -e

staged=$(mktemp)
trap 'rm -f "$staged"' EXIT

# --- Image compression -------------------------------------------------------
git diff --cached --name-only -z --diff-filter=ACM -- \
  '*.png' '*.jpg' '*.jpeg' '*.PNG' '*.JPG' '*.JPEG' > "$staged"

if [ -s "$staged" ]; then
  xargs -0 pnpm images:compress < "$staged"
  xargs -0 git add -- < "$staged"
fi

# --- Glossary validation -----------------------------------------------------
# Only when a glossary source is staged: the validator parses every locale
# file, so it does not need the staged paths themselves — just the signal that
# the glossary changed. Errors block the commit; translation-gap warnings do
# not (see scripts/glossary-validate.ts for the exit-code policy).
if ! git diff --cached --quiet --diff-filter=ACM -- 'config/glossary/*.yaml'; then
  pnpm glossary:validate
fi

# --- Text fragment validation ------------------------------------------------
# Same shape as the glossary block above: a staged fragment body is the signal;
# the validator then reads every fragment and scans the whole docs tree itself.
# Errors block the commit, locale-coverage warnings do not
# (scripts/fragments-validate.ts).
if ! git diff --cached --quiet --diff-filter=ACM -- 'config/fragments/**'; then
  pnpm fragment:validate
fi

# --- CP-NAV and fragment tokens in the guides --------------------------------
# A staged guide is the signal; both validators then scan the whole docs tree
# themselves, so the staged paths are not passed in. This is the block that
# catches an UNTRANSLATED guide — one a locale reaches through a symlink —
# whose tokens are not pinned with |en, which would render a localized block
# under English prose. That case is created by staging docs/ alone, so the
# fragment block above never fires for it. ~4 s.
if ! git diff --cached --quiet --diff-filter=ACM -- 'docs/**/*.mdx'; then
  pnpm cpnav:validate
  pnpm fragment:validate
fi
