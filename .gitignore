# Local
.DS_Store
*.local
*.log*
base

# Never ignore image assets, even if their filename contains substrings
# that match patterns above (e.g. "Activity.Logs.png" vs *.log*).
!**/*.png
!**/*.jpg
!**/*.jpeg
!**/*.gif
!**/*.svg
!**/*.webp

# Dist
node_modules
dist/
doc_build/
doc_build_final/

# Build cache
.last-updated-cache.json

# Generated by scripts/analyze-slug-seo.ts (regenerable)
scripts/slug-seo-report.json

# Generated by scripts/build-locale-availability.ts (regenerable)
theme/data/locale-availability.ts

# Turborepo
.turbo/

# IDE
.vscode/*
!.vscode/extensions.json
.idea
*.txt
!docs/public/robots.txt
